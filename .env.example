# FastAPI / Astro
PUBLIC_COCO_MATCH_API_BASE_URL=http://127.0.0.1:8000
PUBLIC_COCO_MATCH_API_PREFIX=/api/v1
COCO_MATCH_CORS_ORIGINS=
COCO_MATCH_STATIC_DIR=

# Azure AI Foundry Agent Service
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project-name>
AZURE_FOUNDRY_AGENT_ID=<agent-id>
AZURE_FOUNDRY_API_VERSION=v1
# Local testing option. Prefer service principal or managed identity in Azure.
AZURE_FOUNDRY_BEARER_TOKEN=
# Service principal option.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
